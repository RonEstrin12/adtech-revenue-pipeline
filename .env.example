# Mock partner A (REST API)
PARTNER_A_PORT=4001
PARTNER_A_API_KEY=dev-partner-a-key
# Per-attempt timeout for the partner A fetch (ms); attempts are retried up to 3 times
PARTNER_A_TIMEOUT_MS=30000

# S3 (local S3Mock in dev, real AWS S3 in production)
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=raw
AWS_ACCESS_KEY_ID=dev
AWS_SECRET_ACCESS_KEY=dev

# Stage 3: validate and normalize
# DECISION TO CONFIRM: fixed ILS->USD rate, in shekels per US dollar (USD = ILS / rate).
# Defaults to 3.7 when unset. Replace with a daily rate source in src/lib/fx.ts.
FX_ILS_PER_USD=3.7
# DECISION TO CONFIRM: IANA timezone that decides "yesterday" when no date is given (default UTC)
REPORT_TZ=UTC
