# Mock partner A (REST API)
PARTNER_A_PORT=4001
# Base URL ingest calls; defaults to http://localhost:${PARTNER_A_PORT} (the mock). Set it for a real partner.
PARTNER_A_URL=http://localhost:4001
PARTNER_A_API_KEY=dev-partner-a-key
# Per-attempt timeout for the partner A fetch (ms); attempts are retried up to 3 times
PARTNER_A_TIMEOUT_MS=30000

# S3 (local S3Mock in dev, real AWS S3 in production)
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=raw
AWS_ACCESS_KEY_ID=dev
AWS_SECRET_ACCESS_KEY=dev

# Stage 3: validate and normalize
# DECISION TO CONFIRM: fixed ILS->USD rate, in shekels per US dollar (USD = ILS / rate).
# Defaults to 3.7 when unset. Replace with a daily rate source in src/lib/fx.ts.
FX_ILS_PER_USD=3.7
# IANA timezone that decides "yesterday" when no date is given: the publisher's day (Israel)
REPORT_TZ=Asia/Jerusalem

# Stage 4: Postgres warehouse (the docker-compose database locally).
# The standard PG* variables (PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE) work instead if DATABASE_URL is unset.
DATABASE_URL=postgres://pipeline:pipeline@localhost:5432/adtech

# Stage 6: QA checks (npm run qa -- <date>). Each check passes, warns or fails; any fail exits non-zero.
# Partners that must have rows every day (comma-separated).
QA_EXPECTED_PARTNERS=a,b
# Share of a partner's rows rejected (fraction of rows received, 0.25 = 25%): warn above, fail above.
# The seeded mock data rejects 20% (A) and 30% (B) by design, so B warns and nothing fails on a normal day.
QA_WARN_REJECT_SHARE=0.25
QA_MAX_REJECT_SHARE=0.4
# Day-over-day revenue change per partner, in percent either way: warn beyond, fail beyond.
QA_WARN_DOD_CHANGE_PCT=25
QA_MAX_DOD_CHANGE_PCT=50

# Stage 6: alerts as GitHub Issues. SAFETY: nothing is sent unless QA_ALERTS=github; otherwise
# npm run qa prints the issue it would open (dry run). Leave it unset locally.
# GITHUB_TOKEN and GITHUB_REPOSITORY (owner/repo) are provided by GitHub Actions (stage 8);
# the token needs issues: write. Never put a real token in this file.
QA_ALERTS=
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repo

# Stage 7: Google Sheets report (npm run sheets -- <date>).
# SAFETY: nothing is sent to Google unless SHEETS_MODE=google. Empty = dry run: the tabs are written
# to local CSV files in SHEETS_OUT_DIR (default out/sheets, git-ignored) instead. Leave it empty locally.
SHEETS_MODE=
# SHEETS_OUT_DIR=out/sheets
# The long ID in the sheet's URL (docs.google.com/spreadsheets/d/<ID>/edit); a pasted full URL also works.
# SHEETS_SPREADSHEET_ID=
# Service account key: a path to the downloaded key file, or (in GitHub Actions secrets) the key JSON itself.
# Never commit a real key. Share the sheet with the key's client_email as Editor.
# GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
